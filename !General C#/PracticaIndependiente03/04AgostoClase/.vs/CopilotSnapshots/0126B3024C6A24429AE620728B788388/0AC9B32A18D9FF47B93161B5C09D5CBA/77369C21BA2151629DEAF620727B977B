// Compra de divisa 
// Comprar dolares a 37.2
// Vender un dolar a 36.62
// 11mil el maximo de dolares a comprar
// 10mil el maximo de dolares a vender

using System;
namespace divisa
{
    class divissas
    {
        static void Menu()
        {
            Console.WriteLine("1. Comprar divisa");
            Console.WriteLine("2. Vender divisa");
        }
        static double comprar(double cantidadDolares, double precio)
        {
            return cantidadDolares * precio;
        }
        static double vender(double cantidadDolares, double precio)
        {
            return cantidadDolares * precio;
        }
        static void Main(string[] args)
        {
            const double precioCompra = 37.2;
            const double precioVenta = 36.62;
            const double maxCompra = 11000;
            const double maxVenta = 10000;

            Menu();
            while (true)
            {
                Console.WriteLine("Ingrese una opcion: ");
                if (!int.TryParse(Console.ReadLine(), out int opcion))
                {
                    Console.WriteLine("Opcion invalida");
                    continue;
                }
                switch (opcion)
                {
                    case 1:
                        {
                            while (true)

                                Console.WriteLine("Ingrese la cantidad de dolares a comprar: ");
                            if (!double.TryParse(Console.ReadLine(), out double cantidadCompra))
                            {
                                Console.WriteLine("Ingrese un valor valido mayor que 0");
                                continue;
                            }
                            if (cantidadCompra < 1)
                            {
                                Console.WriteLine("Ingrese un valor valido mayor que 0");
                                continue;
                            }
                            if (cantidadCompra > maxCompra)
                            {
                                Console.WriteLine($"El maximo a comprar es {maxCompra} dolares");
                                continue;
                            }

                            double totalCompra = comprar(cantidadCompra, precioCompra);
                            Console.WriteLine("El total a pagar es: " + totalCompra);

                            break;
                    case 2:
                                while (true)
                                    Console.WriteLine("Ingrese la cantidad de dolares a vender: ");
                                if (!double.TryParse(Console.ReadLine(), out double cantidadVenta))
                                {
                                    Console.WriteLine("Ingrese un valor valido");
                                    continue;
                                }
                                if (cantidadVenta < 1)
                                {
                                    Console.WriteLine("Ingrese un valor valido");
                                    continue;
                                }
                                if (cantidadVenta > maxVenta)
                                {
                                    Console.WriteLine($"El maximo a vender es {maxVenta} dolares");
                                    continue;
                                }

                                double totalVenta = vender(cantidadVenta, precioVenta);
                                Console.WriteLine("El total a recibir es: " + totalVenta);

                                break;
                            default:
                                Console.WriteLine("Opcion invalida");
                                break;
                            }
                        }
                }
            }
        }
    }
}
